{
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "composite": true,
    // Emit away from repo root — sibling vite.config.js shadows vite.config.ts for Vite.
    "outDir": ".tsc-node",
    "module": "nodenext",
    "moduleResolution": "nodenext"
  },
  "include": [
    "vite.config.ts",
    "vite.site.config.ts",
    "vitest.config.ts",
    "src/site/mock-openai-middleware.ts"
  ]
}
