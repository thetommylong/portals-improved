{
  "name": "portals-improved",
  "private": true,
  "version": "1.2.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "site:dev": "vite --config vite.site.config.ts",
    "site:build": "vite build --config vite.site.config.ts",
    "site:flatten": "node scripts/flatten-site.mjs",
    "site:build:static": "pnpm site:build && pnpm site:flatten",
    "site:preview": "vite preview --config vite.site.config.ts",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.node.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@catppuccin/palette": "^1.8.0",
    "@eslint/js": "^10.0.1",
    "@material-symbols/svg-400": "0.48.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-svelte": "^3.24.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.4.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.7",
    "vite-plugin-monkey": "^8.1.1",
    "vitest": "^5.0.5",
    "wrangler": "4.159.0"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "dompurify": "^3.4.17",
    "marked": "^18.0.11"
  }
}
